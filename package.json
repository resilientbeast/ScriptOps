{
  "name": "scriptops",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "22.16.0",
    "npm": "10.9.2"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:post-hackathon:ingestion": "vitest run tests/ingestion/post-hackathon-ingestion.verify.test.ts --reporter=verbose",
    "verify:post-hackathon:planning": "vitest run tests/planning/post-hackathon-planning.verify.test.ts tests/integration/initial-plan.test.ts tests/unit/planning-evidence.test.ts --reporter=verbose",
    "verify:post-hackathon:planning:firestore": "vitest run tests/integration/initial-plan.firestore.test.ts --reporter=verbose",
    "verify:post-hackathon:project-ripple": "vitest run tests/integration/project-ripple.test.ts tests/unit/project-proposal.test.tsx --reporter=verbose",
    "verify:post-hackathon:project-export": "vitest run tests/unit/project-export.test.tsx --reporter=verbose",
    "verify:post-hackathon:project-cleanup": "vitest run tests/integration/project-cleanup.test.ts --reporter=verbose",
    "verify:post-hackathon:e2e": "vitest run tests/e2e/post-hackathon-e2e.test.ts --reporter=verbose",
    "verify:post-hackathon:projects": "vitest run tests/integration/project-state.test.ts tests/unit/project-access.test.ts tests/unit/project-contracts.test.ts --reporter=verbose",
    "verify:post-hackathon:projects:firestore": "vitest run tests/integration/project-state.firestore.test.ts --reporter=verbose",
    "verify:post-hackathon:jobs:firestore": "vitest run tests/integration/project-parse-queue.firestore.test.ts --reporter=verbose"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.1",
    "@google-cloud/storage": "7.22.0",
    "@google-cloud/tasks": "7.0.0",
    "@google/adk": "2.0.0",
    "@google/genai": "2.19.0",
    "@react-pdf/renderer": "^4.9.0",
    "fast-xml-parser": "5.11.1",
    "firebase-admin": "14.3.0",
    "google-auth-library": "11.0.2",
    "next": "16.3.3",
    "parallel-web": "1.3.2",
    "pdf-parse": "2.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
