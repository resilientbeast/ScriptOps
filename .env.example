# Clerk access gate
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ALLOWED_USER_IDS=
DEMO_INSTANCE_COOKIE_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/sign-in

# Google Cloud and Gemini
GOOGLE_CLOUD_PROJECT=scriptops-agentic-arkad
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-3.7-flash

# Durable worker dispatch
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_QUEUE=scriptops-ripples
PROJECT_TASKS_QUEUE=scriptops-projects
CLOUD_RUN_BASE_URL=https://scriptops-916693774226.us-central1.run.app
# Comma-separated browser origins permitted to make state-changing requests.
CLOUD_RUN_ALLOWED_ORIGINS=https://scriptops-5sinbwmqzq-uc.a.run.app,https://scriptops-916693774226.us-central1.run.app
TASK_INVOKER_SERVICE_ACCOUNT=scriptops-task-invoker@scriptops-agentic-arkad.iam.gserviceaccount.com
TASK_OIDC_AUDIENCE=https://scriptops-916693774226.us-central1.run.app
SMOKE_TRIGGER_TOKEN=

# Parallel Search
PARALLEL_API_KEY=

# Cost and reliability controls
DAILY_RIPPLE_CAP=20
RIPPLE_STALE_MS=
GEMINI_STAGE_TIMEOUT_MS=
PARALLEL_TIMEOUT_MS=
EVIDENCE_CACHE_TTL_HOURS=72
PROJECT_WORKSPACES_ENABLED=false
PROJECT_PLANNING_ENABLED=false
# Required before enabling planning. Enter verified rates for the configured GEMINI_MODEL
# and Parallel basic Search contract. Blank rates deliberately block new planning starts.
PLANNING_INPUT_USD_PER_MILLION=
PLANNING_OUTPUT_USD_PER_MILLION=
PLANNING_SEARCH_USD_PER_REQUEST=
# Paid synthetic verification is opt-in and never enabled by npm test.
PH09_PROVIDER_TESTS=false
PROJECT_UPLOAD_BUCKET=scriptops-screenplays-scriptops-agentic-arkad-us-central1
PROJECT_UPLOAD_URL_TTL_SECONDS=900
